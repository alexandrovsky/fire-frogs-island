{
	"nodes":[
		{"id":"0004202104080601","type":"group","x":0,"y":0,"width":1880,"height":600,"label":"Welcome"},
		{"id":"8ef917d12c6f5bd0","type":"group","x":980,"y":680,"width":900,"height":700,"label":"2. Sticky notes beside your notes"},
		{"id":"25b2331a19f91cb2","type":"group","x":0,"y":1460,"width":900,"height":700,"label":"3. Notes, files and tables"},
		{"id":"77877125add02374","type":"group","x":980,"y":1460,"width":900,"height":700,"label":"4. Colour, font and shape"},
		{"id":"9dcca8c51255994f","type":"group","x":0,"y":680,"width":900,"height":700,"label":"1. Start here"},
		{"id":"9e6002cb591c9737","type":"group","x":0,"y":2240,"width":900,"height":700,"label":"5. Arrows and drawings"},
		{"id":"b4b84b8a04e3f8ae","type":"group","x":980,"y":2240,"width":900,"height":700,"label":"6. Comments and locking"},
		{"id":"0536aff5c9c495b1","type":"group","x":0,"y":3020,"width":900,"height":700,"label":"7. Make it yours"},
		{"id":"35219908c613db08","type":"group","x":980,"y":3020,"width":900,"height":700,"label":"8. Bring a board or share it"},
		{"id":"13223391ff571e19","type":"group","x":0,"y":3800,"width":900,"height":700,"label":"9. Selection, frames and layers"},
		{"id":"8e123a33e3d3edb9","type":"group","x":980,"y":3800,"width":900,"height":700,"label":"10. Text, code and links"},
		{"id":"52f4d3ebd9b3224f","type":"group","x":0,"y":4580,"width":900,"height":700,"label":"11. Search and move around the board"},
		{"id":"02a90af25d1c3a29","type":"group","x":980,"y":4580,"width":900,"height":700,"label":"12. Drawing and your preferences"},
		{"id":"a43f34e016c1a391","type":"group","x":40,"y":3840,"width":820,"height":270,"label":"Move this frame"},
		{"id":"917797a513e3cae4","type":"group","x":0,"y":5360,"width":1880,"height":700,"label":"Try it here"},
		{"id":"7998a415ce5c6198","type":"text","text":"A free arrow end can stay on empty board. Settings control attraction and snapping to cards. Line-to-line attachment is experimental and disabled by default.","x":40,"y":5125,"width":820,"height":125},
		{"id":"6ac292ae2a7e9245","type":"text","text":"Write on a sticky note, add a note from your vault and connect them with an arrow. Move and change anything. Undo with Ctrl + Z, or Cmd + Z on Mac.","x":40,"y":5400,"width":1800,"height":130},
		{"id":"feff859ec7c415b8","type":"text","text":"Move me","x":80,"y":5610,"width":250,"height":250},
		{"id":"eb15d7216fca24f9","type":"text","text":"Connect us","x":520,"y":5610,"width":250,"height":250},
		{"id":"41f73b3374b0071b","type":"text","text":"Rotate me","x":960,"y":5610,"width":250,"height":250},
		{"id":"3d5088dba534213e","type":"text","text":"Miro and Obsidian on one board","x":40,"y":30,"width":1800,"height":100},
		{"id":"036dc757cb682814","type":"text","text":"Sticky notes, drawings and arrows from Miro. Your notes, files and links from Obsidian.","x":40,"y":150,"width":1800,"height":70},
		{"id":"03332b01ac343d28","type":"text","text":"**From Miro**\n\nSticky notes and shapes, drawing, comments and handy toolbars.","x":40,"y":250,"width":580,"height":220},
		{"id":"59b434e03a2335f4","type":"text","text":"**From Obsidian**\n\nNotes from your vault, Markdown, links and native Canvas. Your files stay with you and work offline.","x":650,"y":250,"width":580,"height":220},
		{"id":"cf2eecfa448511e2","type":"text","text":"**Make it yours**\n\nMouse, touch or pen. Computer, tablet or phone. Choose your tools, fonts and panel layout.","x":1260,"y":250,"width":580,"height":220},
		{"id":"319d757e796da607","type":"text","text":"Your first plan: 1. Start here → 2. Sticky notes → 6. Comments → 8. Export. Use the minimap to reach these sections.","x":40,"y":510,"width":1800,"height":60},
		{"id":"04eb10b7b945bae9","type":"text","text":"Try it right here.","x":40,"y":720,"width":820,"height":80},
		{"id":"cd0b21458d596f54","type":"text","text":"N","x":40,"y":830,"width":64,"height":64},
		{"id":"5417fe3bd1c9b1b3","type":"text","text":"L","x":40,"y":960,"width":64,"height":64},
		{"id":"2b1a98d47804be54","type":"text","text":"**Undo the last action.**\nUse the undo button or Ctrl + Z. On Mac, use Cmd + Z.","x":130,"y":1080,"width":720,"height":110},
		{"id":"29eebd00379686c7","type":"text","text":"Next step\nChoose a place","x":1325,"y":720,"width":210,"height":210},
		{"id":"0e8cb960adbe43b0","type":"text","text":"Done\nTime agreed","x":1630,"y":720,"width":210,"height":210},
		{"id":"edafbe8e55b00591","type":"file","file":"Miro Canvas - Getting started examples/Note.md","x":1020,"y":930,"width":820,"height":210},
		{"id":"b6c45ead9f2de485","type":"text","text":"**Write something on a sticky note.**\nChoose the sticky note tool or press N, then tap an empty part of the board.","x":130,"y":820,"width":720,"height":110},
		{"id":"180bebcccb3977d5","type":"text","text":"**Connect two cards.**\nChoose the arrow tool or press L, then drag from one card to another.","x":130,"y":950,"width":720,"height":110},
		{"id":"21b1f104edbea74c","type":"text","text":"From a card","x":40,"y":2280,"width":150,"height":90},
		{"id":"13b047077145ff4f","type":"text","text":"To a card","x":710,"y":2280,"width":150,"height":90},
		{"id":"9bed2f48fe82390a","type":"text","text":"Meeting place","x":1020,"y":2310,"width":390,"height":180},
		{"id":"8dc79ebbbc08f7d3","type":"text","text":"Locked","x":1460,"y":2310,"width":380,"height":180},
		{"id":"6c4d07c05a1952da","type":"text","text":"Drag the label along the line. Then drag the middle of the arrow: the label stays on it.","x":40,"y":2645,"width":820,"height":90},
		{"id":"7807759b403f86e1","type":"text","text":"","x":40,"y":2715,"width":360,"height":50},
		{"id":"ac9c2c9008c93af7","type":"text","text":"","x":480,"y":2725,"width":340,"height":24},
		{"id":"dd6e6abc1705b6a0","type":"text","text":"**L — lines and arrows · P — pen and highlighter**\n\nPen pressure changes width as you draw. Turn it off in Drawing settings, or enable finger drawing there. Two fingers pan and zoom. Hold the pen at the end of a stroke to straighten it.\n\nDraw an arrow or highlight a word.","x":40,"y":2775,"width":820,"height":155},
		{"id":"fcaa13ea64369ca1","type":"text","text":"Press the comment pin to read the reply.","x":1020,"y":2510,"width":390,"height":90},
		{"id":"43fe0970d8d94b18","type":"text","text":"This card is locked. Unlock it from the menu to move it.","x":1460,"y":2510,"width":380,"height":70},
		{"id":"c6fc4b65bd89590d","type":"text","text":"Press C and choose a place for a comment. Click the pin beside a card to read the discussion. Mark it resolved when the question is settled.\n\nThe toolbar lock protects a card from accidental edits. Try moving the locked card, then unlock it.\n\nThe panel lists comments for the whole board or selected item. Set your name and author colours in settings. Threads stay in the board file; the plugin does not send them to other people.","x":1020,"y":2665,"width":820,"height":250},
		{"id":"ed8dd6aabc4f1dc6","type":"text","text":"The comment with a checkmark is resolved. Open it to reopen the discussion.","x":1460,"y":2590,"width":380,"height":70},
		{"id":"a109b59d60f19640","type":"text","text":"Computer · tablet · phone\nWindows · macOS · Linux · Android · iPhone and iPad","x":40,"y":3060,"width":820,"height":100},
		{"id":"150e54dc2d22d9d6","type":"text","text":"**Find the word “meet”.**\nCtrl + F, or Cmd + F on Mac: search cards and comments.\n\n**Move the panels.**\nGear → Arrange panels. Place them at the side or bottom. Tap the button in the menu to fold a panel; hold it to move the panel. Drag the minimap corner to resize it. Hide it when you need more space.\n\n**Keep your favourite tools.**\nChoose buttons and their order in settings. Other tools stay under “+”. Add fonts from files and adjust zoom.\n\nPanel positions and tool choices are saved separately for computers, tablets and phones.\n\nSettings can hide fold buttons. They remain available while arranging; Reset restores the default layout. Turn panels, reorder tools and move spare tools from +.","x":40,"y":3200,"width":820,"height":500},
		{"id":"08114cb6117412d5","type":"file","file":"Miro Canvas - Getting started examples/Board-export.pdf","x":1020,"y":3060,"width":390,"height":245},
		{"id":"f6f1930256a7980a","type":"file","file":"Miro Canvas - Getting started examples/Board-export.pptx","x":1450,"y":3060,"width":390,"height":155},
		{"id":"1177d1f982580ffd","type":"text","text":"Real exported files: open the PDF or save the PowerPoint to view in a presentation app.","x":1450,"y":3230,"width":390,"height":95},
		{"id":"f75a2beef6d1ed5d","type":"text","text":"**Export on a computer, tablet or phone:** gear → Export to PDF or PowerPoint. The introduction and meeting plan are already marked as pages. Choose paper, orientation, quality and page order, or add a page per frame. Each page or slide is an image of the board. Files are saved in the vault’s attachment folder with unique names. Live web embeds and video are omitted.\n\n**Import:** the guide in settings explains transferring from Miro. Import into a board, from a file menu or command palette, supports Excalidraw, Enhancing Mindmap, Markmind and Advanced Canvas. Preview and report show differences; the source is preserved. Imported board slides can be presented and exported.\n\nWithout the plugin, native Canvas opens cards, files and ordinary edges. Special styling, comments and free lines need the plugin.","x":1020,"y":3345,"width":820,"height":340},
		{"id":"74c1cbc8faa54f94","type":"text","text":"Move me","x":80,"y":3890,"width":160,"height":160},
		{"id":"39ab21dfef8d0df7","type":"text","text":"Connect us","x":540,"y":3890,"width":160,"height":160},
		{"id":"bd81a0a8bb086822","type":"text","text":"Select both cards with a rectangle or lasso and move them together. Drag the frame title to move its contents. Arrows follow cards while moving, resizing and rotating.\n\nCopy cards between boards: styling and rotation stay with them. Use More to change the order of overlapping cards. Side arrows create a neighbouring card or connect to another one.","x":40,"y":4150,"width":820,"height":320},
		{"id":"778217a49ba72eff","type":"text","text":"Markdown works inside a card too: **bold**, *italic*, ~~struck~~, ==marked== and `code`.\n\n$$E = mc^2$$","x":1020,"y":3840,"width":390,"height":220},
		{"id":"b166c9a362012cca","type":"text","text":"```python\nideas = [\"Discuss\", \"Do\"]\nfor idea in ideas:\n    print(idea)\n```","x":1450,"y":3840,"width":390,"height":220},
		{"id":"b491afc6ac4cc132","type":"text","text":"[Obsidian help](https://help.obsidian.md)","x":1020,"y":4085,"width":820,"height":70},
		{"id":"b939fbe74eee4065","type":"text","text":"Use + for code, tables and website links. Cards support Markdown, formulas, lists and Obsidian links.\n\nSelect some text to change its font, size, colour or style. On a phone, hold a word. `![[Note]]` embeds its contents; `[[Note#Heading]]` and `[[Note#^block]]` link to a specific place.","x":1020,"y":4190,"width":820,"height":270},
		{"id":"5ab6c194d2041a16","type":"text","text":"Click or drag on the minimap to visit another area. The zoom percentage opens presets, fit-to-board and snapping options.\n\nCtrl + F, or Cmd + F on Mac, finds text, frame and file names, line labels and comments. Enter visits the next result; Shift + Enter visits the previous one. While editing text, search stays inside that card.\n\nOn touchscreens, one finger pans and two change zoom. Hold an unselected card before dragging; selected cards move immediately. A long press opens a menu or starts selection on empty board.","x":40,"y":4620,"width":820,"height":475},
		{"id":"0f87554f40f63cd8","type":"text","text":"P offers a pen, translucent highlighter, smart drawing and two erasers. Smart drawing recognises shapes and arrows; erasers remove whole strokes or just a part. Shift or holding the pen at the end straightens a line; you can disable holding. Press the active P or L button again to hide its settings.\n\nSettings cover board theme, zoom limits and steps, wheel behaviour, mouse bindings, line snapping, attachment names, your author name and comment colours. Add a font file or download a pack on a press; choose the font order. Automatic update checks can be disabled.\n\nReview mode in the board menu protects content while keeping navigation, links, copying and comments available.","x":1020,"y":4620,"width":820,"height":620},
		{"id":"f543ed1094d48560","type":"text","text":"Keep quick thoughts on sticky notes and details in a note. It is the same note as in your vault: open it and add more. Drag your own note here from the file list.","x":1020,"y":1170,"width":820,"height":160},
		{"id":"8b686cdc58865b05","type":"text","text":"Important\n==Keep the idea==","x":1020,"y":1500,"width":270,"height":220},
		{"id":"57cdea9fb95185d0","type":"text","text":"Rotate me","x":1620,"y":1505,"width":200,"height":200},
		{"id":"ef30ec36a47cf8cd","type":"text","text":"yes","x":1345,"y":1530,"width":200,"height":160},
		{"id":"cae0f3c1478f882d","type":"text","text":"Another board inside this one. Double-click or double-tap to open it.","x":40,"y":1675,"width":380,"height":80},
		{"id":"67c41e686524e1ec","type":"text","text":"This link opens the original note in your vault.","x":460,"y":1675,"width":400,"height":80},
		{"id":"da3ab1600ec81a0b","type":"file","file":"Miro Canvas - Getting started examples/Picture.png","x":40,"y":1775,"width":200,"height":133},
		{"id":"bca6e52f606590ee","type":"file","file":"Miro Canvas - Getting started examples/Document.pdf","x":270,"y":1775,"width":210,"height":220},
		{"id":"9d7f0392dca2df94","type":"file","file":"Miro Canvas - Getting started examples/Document.docx","x":520,"y":1745,"width":160,"height":140},
		{"id":"5db703b405fa77d4","type":"text","text":"↶","x":40,"y":1090,"width":64,"height":64},
		{"id":"16077fd3c651068d","type":"text","text":"Escape puts away the selected tool. On a touchscreen, double tap empty space with a finger or pen.","x":40,"y":1245,"width":820,"height":100},
		{"id":"369a6c6d19e9cd26","type":"text","text":"Idea\nMeet on Friday","x":1020,"y":720,"width":210,"height":210},
		{"id":"b51c799a7fcbb52d","type":"file","file":"Miro Canvas - Getting started examples/Small board.canvas","x":40,"y":1500,"width":380,"height":170},
		{"id":"24ac22dabe116681","type":"text","text":"[[Miro Canvas - Getting started examples/Note|Open the note]]","x":460,"y":1500,"width":400,"height":170},
		{"id":"ea9504c60bb1d9c0","type":"text","text":"Select a card to see its toolbar. Change the font, size, colour or shape. The round handle below a card rotates it.\n\nTry making a sticky note yellow and its text larger.","x":1020,"y":1870,"width":820,"height":240},
		{"id":"6d539bbcdaa6816e","type":"text","text":"| Step | Status |\n| --- | --- |\n| Meeting place | Next |","x":520,"y":1890,"width":340,"height":120},
		{"id":"5be3c14b5a9ca56e","type":"text","text":"Drag in a note or file from your vault. Links and other Canvas boards work here too.\n\nChoose “+” to add code, a table or a website link.\n\nUse “Add file” to choose an image or document from your device. It is saved in your vault with the other attachments.","x":40,"y":2020,"width":820,"height":130}
	],
